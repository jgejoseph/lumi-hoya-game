  "items": [
    {
      "id": 1,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓對水的氣味很敏感，水碗若留下食物碎屑或異味，牠可能喝得比較少；每天換水也要洗碗。",
      "trigger": "feeding",
      "tags": [
        "water"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 2,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓不是一次睡滿整夜，而是分成許多段短睡眠；清晨與傍晚常是牠們較活躍的時段。",
      "trigger": "sleep",
      "tags": [
        "sleep"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 3,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "有些貓會掩埋排泄物，這和牠們保留乾淨活動區域的習性有關；砂盆太髒時可能改找別處。",
      "trigger": "litter",
      "tags": [
        "litter"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 4,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "逗貓棒模仿獵物忽快忽慢的移動，讓貓能追逐、撲抓；偶爾讓牠抓到，遊戲才有完成感。",
      "trigger": "play",
      "tags": [
        "play"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 5,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓主動靠近時，可以先伸手讓牠嗅聞；若身體僵硬或轉身離開，就表示這次互動該停了。",
      "trigger": "petting",
      "tags": [
        "touch"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 6,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "如果貓咪想走開，就讓牠離開，不要硬抱住牠。",
      "trigger": "petting",
      "tags": [
        "boundary"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 7,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "耳朵向後壓可能表示緊張或不耐煩，還要一起觀察尾巴、眼睛和身體姿勢，不能只看一個訊號。",
      "trigger": "annoyed",
      "tags": [
        "body_language"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 8,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓尾巴大幅快速甩動時，常代表情緒變得激動；這和狗開心搖尾巴的意思不一定相同。",
      "trigger": "annoyed",
      "tags": [
        "body_language"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 9,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓的臉頰有氣味腺，輕輕蹭家具或熟悉的人時，會留下自己熟悉的氣味，幫助牠認識環境。",
      "trigger": "petting",
      "tags": [
        "touch"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 10,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓露出肚子可能是在放鬆或打招呼，卻不一定想被摸肚子；先看牠有沒有主動靠近你的手。",
      "trigger": "petting",
      "tags": [
        "touch"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 11,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓鬍鬚的根部連著敏感的神經，能察覺近處物體與空氣細微變化；修剪鬍鬚會干擾牠探索。",
      "trigger": "petting",
      "tags": [
        "whiskers"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 12,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪需要可以躲起來休息的小空間。",
      "trigger": "rest",
      "tags": [
        "safe_space"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 13,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "新貓到新環境時，需要時間慢慢適應。",
      "trigger": "new_cat",
      "tags": [
        "adaptation"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 14,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪看到陌生人時，躲起來不代表牠不乖。",
      "trigger": "new_cat",
      "tags": [
        "emotion"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 15,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪玩得太累，也需要停下來休息。",
      "trigger": "play",
      "tags": [
        "rest"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 16,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "直接用手和貓追打，可能讓牠把手指當成獵物；用逗貓棒能保留追逐樂趣，也較容易保持距離。",
      "trigger": "play",
      "tags": [
        "safety"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 17,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "逗貓棒的細繩適合有人陪同時玩，收起來可避免貓獨自咬斷或吞下線段；玩具也需要定期檢查。",
      "trigger": "play",
      "tags": [
        "safety"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 18,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "小球和玩具不能太小，避免被貓咪誤吞。",
      "trigger": "play",
      "tags": [
        "safety"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 19,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "窗戶和陽台要注意防護，避免貓咪意外掉下去。",
      "trigger": "safety",
      "tags": [
        "home"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 20,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "有些植物對貓咪有害，不要讓牠隨便啃植物。",
      "trigger": "plant",
      "tags": [
        "safety"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 21,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "巧克力不能當作貓咪的零食。",
      "trigger": "food_warning",
      "tags": [
        "food"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 22,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "洋蔥和大蒜不適合給貓咪吃。",
      "trigger": "food_warning",
      "tags": [
        "food"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 23,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "人吃的食物常常太鹹，不適合直接給貓咪吃。",
      "trigger": "feeding",
      "tags": [
        "food"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 24,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪的食物要放在乾淨的碗裡。",
      "trigger": "feeding",
      "tags": [
        "food"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 25,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪吃東西時，讓牠安靜吃會比較舒服。",
      "trigger": "feeding",
      "tags": [
        "boundary"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 26,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "吃完東西後，也要記得幫貓咪準備乾淨的水。",
      "trigger": "feeding",
      "tags": [
        "water"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 27,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓舔毛時，舌頭表面的小倒鉤會帶走鬆脫的毛髮；換毛時適度梳毛，也能減少牠吞進的毛。",
      "trigger": "grooming",
      "tags": [
        "grooming"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 28,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "定期梳毛可以幫助整理掉落的毛。",
      "trigger": "grooming",
      "tags": [
        "grooming"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 29,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "梳毛時要輕輕的，不要拉扯打結的毛。",
      "trigger": "grooming",
      "tags": [
        "touch"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 30,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "不要使用人類的洗髮精幫貓咪洗澡。",
      "trigger": "grooming",
      "tags": [
        "safety"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 31,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "抓抓不只是磨爪，也能伸展身體、留下氣味訊號；在常走動的地方放抓板，比藏在角落更實用。",
      "trigger": "scratch",
      "tags": [
        "behavior"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 32,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪高高低低地跳來跳去，是很自然的活動。",
      "trigger": "climb",
      "tags": [
        "behavior"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 33,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "窗外快速移動的鳥會吸引貓的視線，因為追蹤小型動物的動作本來就是牠們的天性。",
      "trigger": "bird_event",
      "tags": [
        "bird"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 34,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓專心看窗外時，突然從背後碰牠可能引發驚跳；先讓牠聽見你的聲音，再慢慢靠近。",
      "trigger": "bird_event",
      "tags": [
        "bird",
        "boundary"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 35,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "呼嚕常在放鬆時出現，但緊張時也可能呼嚕；要一起看耳朵、瞳孔與姿勢，才能判斷心情。",
      "trigger": "petting",
      "tags": [
        "purr"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 36,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "每隻貓咪的個性都不同，要慢慢了解牠喜歡什麼。",
      "trigger": "random",
      "tags": [
        "personality"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 37,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪如果突然很沒精神，要記得告訴大人。",
      "trigger": "health_notice",
      "tags": [
        "health"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 38,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "貓咪如果長時間不吃東西，要記得告訴大人。",
      "trigger": "health_notice",
      "tags": [
        "health"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 39,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "不要追著不想玩的貓咪跑，讓牠自己決定要不要互動。",
      "trigger": "petting",
      "tags": [
        "boundary"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 40,
      "category": "cat_care",
      "title": "🐾 養貓小常識",
      "text": "溫柔、安靜地陪伴，通常比一直抱著貓咪更讓牠安心。",
      "trigger": "random",
      "tags": [
        "bond"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 41,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "聲音的高低取決於振動頻率，音量則和振幅有關；蚊子的細嗡聲與雷聲因此聽起來差很多。",
      "trigger": "random",
      "tags": [
        "sound"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 42,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "影子會隨著光線方向改變位置。",
      "trigger": "random",
      "tags": [
        "light"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 43,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "陽光裡有許多顏色，短波長的藍光較容易被空氣散射，所以晴朗白天的天空常看起來是藍色。",
      "trigger": "random",
      "tags": [
        "sky"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 44,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "水在很冷的時候會結成冰。",
      "trigger": "random",
      "tags": [
        "water"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 45,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "冰變暖後，會慢慢融化成水。",
      "trigger": "random",
      "tags": [
        "water"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 46,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "磁鐵可以吸引某些含鐵的物品。",
      "trigger": "random",
      "tags": [
        "magnet"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 47,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "植物會利用陽光製造生長需要的養分。",
      "trigger": "random",
      "tags": [
        "plant"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 48,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "我們呼吸時，身體會吸入氧氣。",
      "trigger": "random",
      "tags": [
        "body"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 49,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "心臟不停跳動，幫助血液在身體裡流動。",
      "trigger": "random",
      "tags": [
        "body"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 50,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "月亮並不自己發光；月相變化是因為太陽照亮月球的一半，而我們每天看到的亮面角度不同。",
      "trigger": "night",
      "tags": [
        "space"
      ],
      "age_level": "中高年級",
      "enabled": true
    },
    {
      "id": 51,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "地球繞著太陽運行。",
      "trigger": "random",
      "tags": [
        "space"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 52,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "一天有白天和夜晚，和地球自轉有關。",
      "trigger": "night",
      "tags": [
        "space"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 53,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "聲音越遠，通常聽起來會越小聲。",
      "trigger": "random",
      "tags": [
        "sound"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 54,
      "category": "science",
      "title": "🔬 科學小知識",
      "text": "摩擦可以讓物體慢下來，也可能產生熱。",
      "trigger": "random",
      "tags": [
        "force"
      ],
      "age_level": "低年級",
      "enabled": false
    },
    {
      "id": 55,
